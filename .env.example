# Local Docker preview. Change domain values for cloud deployment.
HOST=127.0.0.1
PORT=8080
DATA_DIR=data
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
MCP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
MCP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Explicit opt-in to credential registration. false keeps existing credentials valid.
REGISTRATION_OPEN=true
